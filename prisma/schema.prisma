generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                  Int       @id @default(autoincrement())
  name                String?   @db.VarChar(150)
  email               String    @unique @db.VarChar(255)
  password            String?   @db.VarChar(255)
  reset_token         String?   @db.VarChar(255)
  reset_token_expires DateTime?
  ativo               Boolean   @default(false)

  @@map("admins")
}

model Professor {
  id                  Int              @id @default(autoincrement())
  name                String?          @db.VarChar(150)
  email               String           @unique @db.VarChar(255)
  password            String?          @db.VarChar(255)
  reset_token         String?          @db.VarChar(255)
  reset_token_expires DateTime?
  ativo               Boolean          @default(false)
  turmas              ProfessorTurma[]

  @@map("professors")
}

model Turma {
  id          Int              @id @default(autoincrement())
  nome        String           @db.VarChar(150)
  escola_id   Int?
  nucleo_id   Int?
  capacidade  Int?             @db.UnsignedTinyInt
  escola      Escola?          @relation(fields: [escola_id], references: [id])
  nucleo      Nucleo?          @relation(fields: [nucleo_id], references: [id])
  professores ProfessorTurma[]
  alunos      Aluno[]

  @@map("turmas")
}

model Nucleo {
  id          Int     @id @default(autoincrement())
  nome        String  @unique @db.VarChar(150)
  localizacao String? @db.VarChar(255)
  turmas      Turma[]
  alunos      Aluno[]

  @@map("nucleos")
}

model Escola {
  id       Int     @id @default(autoincrement())
  nome     String  @unique @db.VarChar(255)
  endereco String? @db.VarChar(255)
  turmas   Turma[]
  alunos   Aluno[]

  @@map("escolas")
}

model Aluno {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(150)
  matricula String  @db.VarChar(100)
  nucleo_id Int?
  idade     Int?    @db.UnsignedTinyInt
  ativo     Boolean @default(true)
  dia_aula  String? @db.VarChar(50)
  bairro    String  @db.VarChar(150)
  turma_id  Int?
  escola_id Int?
  turma     Turma?  @relation(fields: [turma_id], references: [id], onDelete: SetNull)
  nucleo    Nucleo? @relation(fields: [nucleo_id], references: [id], onDelete: SetNull)
  escola    Escola? @relation(fields: [escola_id], references: [id], onDelete: SetNull)

  @@map("alunos")
}

model Invite {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(255)
  role       Role
  created_at DateTime @default(now())

  @@map("invites")
}

model ProfessorTurma {
  professor_id Int
  turma_id     Int
  professor    Professor @relation(fields: [professor_id], references: [id], onDelete: Cascade)
  turma        Turma     @relation(fields: [turma_id], references: [id], onDelete: Cascade)

  @@id([professor_id, turma_id])
  @@map("professor_turmas")
}

enum Role {
  professor
  admin
}
