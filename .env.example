PORT=3001
JWT_SECRET=sua_chave_jwt_aqui
JWT_EXPIRES_IN=1h
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_db_user
DB_PASSWORD=sua_db_password
DB_NAME=seu_db_name
# Usada apenas pelo Docker Compose (senha root do MySQL)
MYSQL_ROOT_PASSWORD=sua_root_password
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# SMTP (e-mail para convite de professoras)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="GoLGirls <seu-email@gmail.com>"

# URL do frontend (usada no link de definição de senha)
APP_URL=http://localhost:5173
