PORT=3001
JWT_SECRET=seu_jwt_secret_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=1h

MYSQL_ROOT_PASSWORD=sua_senha_root_mysql

DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_db_user
DB_PASSWORD=sua_db_password
DB_NAME=seu_db_name
# dotenv não expande ${DB_USER} automaticamente
DATABASE_URL=mysql://seu_db_user:sua_db_password@localhost:3306/seu_db_name
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# SMTP (e-mail para convite de professoras)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="GoLGirls <seu-email@gmail.com>"

# URL do frontend (usada no link de definição de senha)
APP_URL=http://localhost:5173
